# Copy to .env.local (scripts/bootstrap-localnet.ts writes it for the localnet).
# NEXT_PUBLIC_* values are compiled into the browser bundle: never put secrets there.
NEXT_PUBLIC_VAPOR_NETWORK_NAME=VaporChain Localnet
NEXT_PUBLIC_VAPOR_EVM_CHAIN_ID=779700
NEXT_PUBLIC_VAPOR_COSMOS_CHAIN_ID=vapor-local-1
NEXT_PUBLIC_VAPOR_RPC=http://127.0.0.1:8545
NEXT_PUBLIC_VAPOR_REST=http://127.0.0.1:1317
NEXT_PUBLIC_VAPOR_COMET=http://127.0.0.1:26657
NEXT_PUBLIC_VAPOR_BUNDLER=http://127.0.0.1:4337
NEXT_PUBLIC_VAPOR_SPONSOR=http://127.0.0.1:8800
NEXT_PUBLIC_VAPOR_INDEXER=http://127.0.0.1:8900
NEXT_PUBLIC_VAPOR_EXPLORER=
NEXT_PUBLIC_VAPOR_USDC=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_VAPOR_TOKEN_FACTORY=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_SHOP_APP_ID=
NEXT_PUBLIC_SHOP_CHECKOUT=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_LAUNCHPAD_APP_ID=
NEXT_PUBLIC_FAUCET_ENABLED=0

# server-only
VAPOR_FAUCET_KEY_FILE=
VAPOR_FAUCET_AMOUNT=25000000
