VAPOR_TAG=latest
# your own node's endpoints (this stack does not run consensus)
VAPOR_EVM_RPC=http://host.docker.internal:8545
VAPOR_REST=http://host.docker.internal:1317
VAPOR_COMET=http://host.docker.internal:26657
VAPOR_PAYMASTER=0x0000000000000000000000000000000000000000
VAPOR_ARCHIVE_EVERY=10000
# comma-separated; leave empty to reject all X-Forwarded-For (direct exposure)
VAPOR_TRUSTED_PROXIES=
VAPOR_CORS_ORIGINS=
# secret files (chmod 600), see secrets/ paths below
PG_PASSWORD_FILE=./secrets/pg_password
SPONSOR_SIGNER_FILE=./secrets/sponsor_signer
EXECUTOR_KEYS_FILE=./secrets/executor_keys
UTILITY_KEY_FILE=./secrets/utility_key
