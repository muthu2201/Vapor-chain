[Unit]
Description=VaporChain Alto bundler
After=network-online.target
Wants=network-online.target

[Service]
User=vapor
Group=vapor
EnvironmentFile=/etc/vaporchain/bundler.env
WorkingDirectory=/opt/vaporchain/bundler
ExecStart=/opt/vaporchain/bundler/start.sh
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/etc/vaporchain

[Install]
WantedBy=multi-user.target
