#
# VaporChain validator/RPC node under Cosmovisor (auto-applies gov upgrades).
# Install: see deploy/README.md. Runs as an unprivileged `vapor` user.
[Unit]
Description=VaporChain node (cosmovisor)
After=network-online.target
Wants=network-online.target

[Service]
User=vapor
Group=vapor
Environment=DAEMON_NAME=vaporchaind
Environment=DAEMON_HOME=/var/lib/vaporchain
Environment=DAEMON_ALLOW_DOWNLOAD_BINARIES=false
Environment=DAEMON_RESTART_AFTER_UPGRADE=true
Environment=DAEMON_LOG_BUFFER_SIZE=512
Environment=UNSAFE_SKIP_BACKUP=false
ExecStart=/usr/local/bin/cosmovisor run start --home /var/lib/vaporchain
Restart=on-failure
RestartSec=3
LimitNOFILE=65535
# hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/vaporchain
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
