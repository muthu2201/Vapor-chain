[Unit]
Description=VaporChain sponsor service
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=vapor
Group=vapor
EnvironmentFile=/etc/vaporchain/sponsor.env
ExecStart=/usr/local/bin/vapor-sponsor
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true
# key files are 0600 root:vapor under /etc/vaporchain/secrets
ReadOnlyPaths=/etc/vaporchain

[Install]
WantedBy=multi-user.target
