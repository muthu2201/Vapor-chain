{
  "name": "@vaporchain/sdk",
  "version": "1.0.0",
  "description": "VaporChain developer SDK: gasless checkout, sponsored UserOps, token launch, Skip:Go bridging",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --dir test/unit",
    "test:e2e": "vitest run --dir test/e2e"
  },
  "peerDependencies": {
    "viem": "^2.56.8"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "typescript": "7.0.2",
    "viem": "2.56.8",
    "vitest": "5.0.1"
  }
}
